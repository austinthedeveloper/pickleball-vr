; Engine configuration file.
; Pickleball '94 VR. Godot 4.7 (pinned in README; decisions/ADR-001).

config_version=5

[application]

config/name="Pickleball '94 VR"
config/description="First-person pickleball, from the SNES game's port kit."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/version="0.7.0"
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.04, 0.06, 0.12, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/extensions/meta/passthrough=true
shaders/enabled=true
